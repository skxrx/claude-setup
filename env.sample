# Harness configuration — copy to harness.env (git-ignored) and fill in what you need.
#   cp env.sample harness.env
# NOTHING here is required for memory to work: embeddings run locally by default.
# Both MCP servers read this file at startup; process env vars override it.

# ── Semantic memory (works out of the box, no keys) ───────────────
MEMORY_DB_URL=postgresql://harness:harness@127.0.0.1:5433/harness_memory
# Provider: local (default, fastembed/ONNX on CPU — no key, no network after
# first model download) | openai | voyage | ollama
EMBED_PROVIDER=local
# Defaults per provider if left empty:
#   local  -> intfloat/multilingual-e5-large            (dim 1024, ~2.2GB, best RU/EN quality)
#             lighter: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (dim 384, ~0.2GB)
#   openai -> text-embedding-3-small                    (dim 1536)
#   voyage -> voyage-3.5                                (dim 1024)
#   ollama -> nomic-embed-text                          (dim 768)
EMBED_MODEL=
# MUST match the model's dimension. Changing it requires re-embedding
# (clear memories, or call reindex_embeddings on an empty-embedding set).
EMBED_DIM=1024
# Similarity threshold above which remember() supersedes an existing memory
MEM_SUPERSEDE_SIM=0.90
VOYAGE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Cross-review with an external model (THE ONLY thing needing OpenAI) ──
# Used exclusively by /cross-review and /debate. Memory does not touch it.
OPENAI_API_KEY=
SECOND_OPINION_MODEL=gpt-5.6-sol
# Any OpenAI-compatible endpoint works.
SECOND_OPINION_BASE_URL=https://api.openai.com/v1
# Optional: low | medium | high (omit to use provider default)
SECOND_OPINION_REASONING_EFFORT=

# ── Chain explorers (used by /investigate via curl) ───────────────
# Free key, covers 60+ EVM chains: https://etherscan.io/apis
# Bitcoin (mempool.space) and Solana public RPC need NO key at all.
ETHERSCAN_API_KEY=
# Optional: raises TronGrid rate limits
TRON_PRO_API_KEY=
# Optional: better Solana history parsing
HELIUS_API_KEY=
